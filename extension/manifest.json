{
  "manifest_version": 3,
  "name": "AccèsCheck — Compagnon de consultation",
  "description": "Sous-titres et communication contrôlée par le patient, à côté de Doctolib. Prototype avec appel fictif et pont MCP local.",
  "version": "0.2.0",
  "minimum_chrome_version": "135",
  "permissions": [
    "activeTab",
    "tabCapture",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:4180/*"
  ],
  "action": {
    "default_title": "Ouvrir AccèsCheck pour cet onglet"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:4180"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  }
}
