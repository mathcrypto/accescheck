# Microsoft Edge TTS (no API key). Optional voice override.
EDGE_TTS_VOICE=fr-FR-DeniseNeural

# Local SQLite file; ignored by Git. Defaults to .local/practices.sqlite.
DATABASE_PATH=
# Used only by the authenticated hosted importer.
DATA_IMPORT_URL=
DATA_IMPORT_TOKEN=
DATA_SITE_ACCESS_TOKEN=

# Server-side OpenAI key. Search sends full request/context only after consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Main reasoning/tool model for patient search, separate from the fictional bridge.
OPENAI_SEARCH_MODEL=gpt-6.1-sol

# Web-search model for public reviews; receives public identity only.
OPENAI_REVIEW_MODEL=gpt-6-luna
