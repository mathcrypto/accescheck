# Microsoft Edge TTS (no API key). Optional voice override.
EDGE_TTS_VOICE=fr-FR-DeniseNeural

# Local SQLite file; ignored by Git. Defaults to .local/practices.sqlite.
DATABASE_PATH=
# Used only by the authenticated hosted importer.
DATA_IMPORT_URL=
DATA_IMPORT_TOKEN=
DATA_SITE_ACCESS_TOKEN=

# Optional AI translation. The model receives only the needs description.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional web-search model for public reviews, independent of needs interpretation.
OPENAI_REVIEW_MODEL=gpt-6-luna
