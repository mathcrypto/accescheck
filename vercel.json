{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": ".vercel-data/practices.sqlite"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
